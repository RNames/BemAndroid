# ============================================================
# SENSITIVE / CREDENTIALS (JANGAN PERNAH DI-PUSH!)
# ============================================================

# Firebase config (berisi API Key & project credentials)
google-services.json
GoogleService-Info.plist

# Keystore files (production signing keys)
*.keystore
!debug.keystore
*.jks

# Environment variables / secrets
.env
.env.*
!.env.example

# ============================================================
# OPERATING SYSTEM
# ============================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# ============================================================
# ANDROID
# ============================================================

# Gradle build outputs & caches
android/build/
android/app/build/
android/.gradle/
android/.kotlin/
android/.cxx/
android/app/.cxx/
*.iml
*.apk

# Local machine properties (berisi path SDK lokal)
android/local.properties

# IntelliJ / Android Studio
.idea/

# Proguard generated files
android/app/src/main/assets/react/

# ============================================================
# iOS / XCODE
# ============================================================

# Xcode build artifacts
ios/build/
ios/DerivedData/
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata/
*.xccheckout
*.moved-aside
*.xcuserstate
**/.xcode.env.local

# CocoaPods (generated, bisa di-restore dengan pod install)
ios/Pods/

# ============================================================
# NODE / REACT NATIVE
# ============================================================

# Node modules (bisa di-restore dengan npm install)
node_modules/

# Logs
npm-debug.log
yarn-error.log
*.log

# Bundle artifacts
*.jsbundle

# Metro bundler
.metro-health-check*

# ============================================================
